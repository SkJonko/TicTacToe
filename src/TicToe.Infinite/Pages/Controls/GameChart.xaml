<?xml version="1.0" encoding="utf-8" ?>
<Border
    x:Class="TicToe.Infinite.Pages.Controls.GameChart"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pageModels="clr-namespace:TicToe.Infinite.PageModels"
    xmlns:shimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
    xmlns:strings="clr-namespace:TicToe.Infinite.Resources.Strings"
    Margin="0,12"
    x:DataType="pageModels:DashboardPageModel"
    HeightRequest="{OnIdiom 300, Phone=200}"
    Style="{StaticResource CardStyle}">

    <shimmer:SfShimmer BackgroundColor="Transparent" IsActive="{Binding IsBusy}">
        <shimmer:SfShimmer.CustomView>
            <Grid>
                <BoxView CornerRadius="12" Style="{StaticResource ShimmerCustomViewStyle}" VerticalOptions="Fill" />
            </Grid>
        </shimmer:SfShimmer.CustomView>
        <shimmer:SfShimmer.Content>
            <chart:SfCircularChart x:Name="Chart" SemanticProperties.Description="{x:Static strings:SemanticDescriptions.GameChart_CircularChart}">
                <chart:DoughnutSeries
                    x:Name="doughnutSeries"
                    EnableTooltip="False"
                    InnerRadius="0.7"
                    ItemsSource="{Binding WinnerData}"
                    PaletteBrushes="{Binding WinnerColors}"
                    Radius="{OnIdiom 0.6, Phone=0.5}"
                    ShowDataLabels="True"
                    XBindingPath="Player"
                    YBindingPath="Count">

                    <chart:DoughnutSeries.LabelTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout x:DataType="chart:ChartDataLabel">
                                <Label FontSize="{OnIdiom 18, Phone=14}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Item.Player}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding Item.Count}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </chart:DoughnutSeries.LabelTemplate>

                    <chart:DoughnutSeries.DataLabelSettings>
                        <chart:CircularDataLabelSettings LabelPosition="Outside" SmartLabelAlignment="Shift">
                            <chart:CircularDataLabelSettings.ConnectorLineSettings>
                                <chart:ConnectorLineStyle ConnectorType="Line" StrokeWidth="3" />
                            </chart:CircularDataLabelSettings.ConnectorLineSettings>
                        </chart:CircularDataLabelSettings>
                    </chart:DoughnutSeries.DataLabelSettings>
                </chart:DoughnutSeries>

            </chart:SfCircularChart>
        </shimmer:SfShimmer.Content>
    </shimmer:SfShimmer>

</Border>